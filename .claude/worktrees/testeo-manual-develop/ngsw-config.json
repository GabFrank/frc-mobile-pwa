{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    },
    {
      "name": "face-models",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/face-models/**"
        ]
      }
    }
  ],
  "appData": {
    "etiqueta": "__SELLO_ETIQUETA__",
    "fecha": "__SELLO_FECHA__",
    "commit": "__SELLO_COMMIT__"
  }
}